# Required for private accounts and persistent loan/history records.
DATABASE_URL=mysql+mysqlconnector://YOUR_USER:YOUR_PASSWORD@localhost:3306/YOUR_DATABASE
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=zorentia-app
COOKIE_SECURE=false
# Opt in only for a local MySQL user that already has an empty password.
ALLOW_PASSWORDLESS_LOCAL_DB=false
